# Copy this file to backend/.env and fill in real values.
# Lines left blank use safe defaults (see settings.py) so the site still
# runs locally, but payments/AI-chatbot/email will be limited until set.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Public URL of the deployed frontend (used to build password-reset links
# and the Cashfree payment return URL). For local dev this is fine as-is.
FRONTEND_URL=http://localhost:5173

# --- Database ------------------------------------------------------------
# Leave blank for local dev — uses a local SQLite file (backend/db.sqlite3).
# On Render's free plan the disk is wiped on every deploy, so production
# MUST set this to a persistent Postgres connection string or all orders
# and admin edits will be lost on the next redeploy. Free, non-expiring
# Postgres: https://neon.tech or https://supabase.com
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Cashfree Payment Gateway (TEST MODE) -----------------------------
# Sign up for a free TEST account at https://merchant.cashfree.com/merchants/signup
# then copy the Test App ID / Test Secret Key from
# Developers > API Keys (make sure the "Test Mode" toggle is on).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# GST added on top of the cart subtotal at checkout (split into equal
# CGST + SGST on the invoice). Default 3% matches the standard slab for
# gold/diamond jewellery in India — change if your products differ.
GST_RATE=0.03
# Your business GSTIN, shown on the invoice PDF. Leave blank while testing.
GSTIN=

# --- Email (order confirmations, password reset) ----------------------
# Defaults to printing emails to the console if left blank.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VETRI Fine Jewellery <concierge@vetrijewels.com>
ADMIN_EMAIL=concierge@vetrijewels.com

# --- AI Chatbot (optional) --------------------------------------------
# Without this key, the chatbot still answers offers/order-tracking
# questions using the store's own data — only open-ended free-form
# questions fall back to a generic "ask WhatsApp" reply.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- WhatsApp (optional) -----------------------------------------------
# Click-to-chat (wa.me) links already work using ShopSettings.whatsapp_number
# in the Django admin — no key needed for that.
#
# These two enable AUTOMATED WhatsApp order-status messages (sent when an
# order becomes Paid / Shipped / Out for Delivery / Delivered). This needs
# a real Meta Business + WhatsApp API setup, not just a signup:
#   1. Create a Meta Business account: https://business.facebook.com
#   2. Create an app at https://developers.facebook.com/apps -> add the
#      "WhatsApp" product
#   3. Under WhatsApp > API Setup you'll get a temporary access token and
#      a "Phone number ID" — paste them below
#   4. In sandbox/dev mode you can only message phone numbers you've added
#      to the app's allowed test recipient list (WhatsApp > API Setup ->
#      "To" list) — add your own number there to test
# Without these set, order-status WhatsApp messages are silently skipped
# (logged only) — everything else on the site keeps working normally.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
