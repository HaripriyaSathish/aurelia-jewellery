# Copy this file to backend/.env and fill in real values.
# Lines left blank use safe defaults (see settings.py) so the site still
# runs locally, but payments/AI-chatbot/email will be limited until set.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Public URL of the deployed frontend (used to build password-reset links
# and the Cashfree payment return URL). For local dev this is fine as-is.
FRONTEND_URL=http://localhost:5173

# --- Database ------------------------------------------------------------
# Leave blank for local dev — uses a local SQLite file (backend/db.sqlite3).
# On Render's free plan the disk is wiped on every deploy, so production
# MUST set this to a persistent Postgres connection string or all orders
# and admin edits will be lost on the next redeploy. Free, non-expiring
# Postgres: https://neon.tech or https://supabase.com
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Product image uploads (optional) -----------------------------------
# Leave blank for local dev — uploaded images (Django admin's Image field
# on a product) are saved to backend/media/ and served directly.
# REQUIRED in production for uploaded images to work at all: Render's
# disk is ephemeral (same reason DATABASE_URL is required above), and
# Django doesn't serve /media/ files when DEBUG=False regardless.
# Free tier: sign up at https://cloudinary.com, then copy the "API
# Environment variable" shown on your Dashboard — it already comes in
# this exact format, just paste it as-is:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Note: this only affects uploaded files. Products using the separate
# "Image URL" field (an external link, e.g. Unsplash) work regardless.
CLOUDINARY_URL=

# --- Cashfree Payment Gateway (TEST MODE) -----------------------------
# Sign up for a free TEST account at https://merchant.cashfree.com/merchants/signup
# then copy the Test App ID / Test Secret Key from
# Developers > API Keys (make sure the "Test Mode" toggle is on).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# GST added on top of the cart subtotal at checkout (split into equal
# CGST + SGST on the invoice). Default 3% matches the standard slab for
# gold/diamond jewellery in India — change if your products differ.
GST_RATE=0.03
# Your business GSTIN, shown on the invoice PDF. Leave blank while testing.
GSTIN=

# --- Email (order confirmations, password reset) ----------------------
# Defaults to printing emails to the console if left blank.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VETRI Fine Jewellery <concierge@vetrijewels.com>
ADMIN_EMAIL=concierge@vetrijewels.com

# --- AI Chatbot (optional) --------------------------------------------
# Without this key, the chatbot still answers offers/order-tracking
# questions using the store's own data — only open-ended free-form
# questions fall back to a generic "ask WhatsApp" reply.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- WhatsApp (optional) -----------------------------------------------
# Click-to-chat (wa.me) links already work using ShopSettings.whatsapp_number
# in the Django admin — no key needed for that.
#
# Set EITHER of the two blocks below to enable AUTOMATED WhatsApp
# order-status messages (sent when an order becomes Paid / Shipped /
# Out for Delivery / Delivered). Without either set, these messages
# are silently skipped (logged only) — everything else keeps working.

# Option A (easiest to test): Twilio's WhatsApp Sandbox — no Meta
# Business verification needed.
#   1. Sign up free at https://www.twilio.com
#   2. Console -> Messaging -> Try it out -> Send a WhatsApp message
#   3. From your own phone, WhatsApp the "join <your-code>" text shown
#      there to Twilio's sandbox number — that number can now message
#      you back. Other people must join the same way to receive messages.
#   4. Copy your Account SID and Auth Token from the Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: Meta's WhatsApp Business Cloud API directly (needs a
# verified Meta Business account + an app with the WhatsApp product —
# see https://developers.facebook.com/apps -> WhatsApp -> API Setup).
# Only used if the Twilio variables above are left blank.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
