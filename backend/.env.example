# Copy this file to backend/.env and fill in real values.
# Lines left blank use safe defaults (see settings.py) so the site still
# runs locally, but payments/AI-chatbot/email will be limited until set.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Public URL of the deployed frontend (used to build password-reset links
# and the Cashfree payment return URL). For local dev this is fine as-is.
FRONTEND_URL=http://localhost:5173

# --- Cashfree Payment Gateway (TEST MODE) -----------------------------
# Sign up for a free TEST account at https://merchant.cashfree.com/merchants/signup
# then copy the Test App ID / Test Secret Key from
# Developers > API Keys (make sure the "Test Mode" toggle is on).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# --- Email (order confirmations, password reset) ----------------------
# Defaults to printing emails to the console if left blank.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VETRI Fine Jewellery <concierge@vetrijewels.com>
ADMIN_EMAIL=concierge@vetrijewels.com

# --- AI Chatbot (optional) --------------------------------------------
# Without this key, the chatbot still answers offers/order-tracking
# questions using the store's own data — only open-ended free-form
# questions fall back to a generic "ask WhatsApp" reply.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- WhatsApp (optional) -----------------------------------------------
# Click-to-chat (wa.me) links already work using ShopSettings.whatsapp_number
# in the Django admin — no key needed for that. These are only needed if
# you later wire up the WhatsApp Business Cloud API for automated
# order-status push messages.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
